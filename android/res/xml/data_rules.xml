<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: worlds and notebooks go to the Google account
     backup and move to a new phone; nothing else (the agent key stays). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="data/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="data/" />
    </device-transfer>
</data-extraction-rules>
